# Platform operator pubkey (hex) to receive platform fees
NEXT_PUBLIC_PLATFORM_FEE_PUBKEY=
# Platform fee percentage (default: 3)
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=3
# Marketplace display name
NEXT_PUBLIC_MARKETPLACE_NAME=Satstr
# Default relay URLs separated by commas
NEXT_PUBLIC_DEFAULT_RELAYS=
# Admin pubkey (hex) for moderation panel access
NEXT_PUBLIC_ADMIN_PUBKEY=
# Platform operator Lightning address for Lightning fee collection (e.g. operator@getalby.com)
NEXT_PUBLIC_PLATFORM_FEE_LN_ADDRESS=
